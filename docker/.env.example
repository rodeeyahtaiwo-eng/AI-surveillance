# Copy to docker/.env before running `docker compose up`. Never commit the real file.

POSTGRES_USER=surveillance
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=surveillance

JWT_SECRET=replace-with-a-long-random-string
INGEST_API_KEY=replace-with-a-long-random-string

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Default Admin

# Must match how the frontend's build reaches the backend from the BROWSER (not from
# inside Docker's network) — localhost:4000 if you're just running this on one machine.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
