# Copy to .env. No secrets in this service.

AI_SERVICE_URL=http://localhost:8000

# Frames sampled per second sent to ai-service — deliberately NOT every raw frame (see
# docs/architecture.md "Real-time processing"). 2 fps is enough for the demo pipeline's
# action-recognition window (SEQUENCE_WINDOW_SECONDS in ai-service/.env).
SAMPLE_FPS=2
