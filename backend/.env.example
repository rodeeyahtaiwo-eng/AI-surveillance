# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- Database ---
# Local dev default (SQLite, zero-config). Note: Prisma resolves a relative sqlite
# `file:` path against database/schema.prisma's own directory, not this .env's location
# — so this actually creates database/dev.db, not backend/dev.db. Harmless, just
# surprising the first time; see docs/database.md.
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL via docker/docker-compose.yml) — also requires changing
# `provider` in database/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://surveillance:surveillance@localhost:5432/surveillance"

# --- Auth ---
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Seed admin account (used by `npm run db:seed`, workspace: backend)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Default Admin

# --- Internal service-to-service auth ---
# Shared secret ai-service/video-processing must send as `x-ingest-key` when POSTing
# inference results to /api/inference. Never exposed to the frontend.
INGEST_API_KEY=replace-with-a-long-random-string

# --- Other services ---
AI_SERVICE_URL=http://localhost:8000

# --- Uploaded-video processing (Phase 2AM) ---
# Paths to the sibling video-processing project on this same machine, used to spawn its
# existing `run_camera.py --source file` CLI after an upload — see
# src/services/videoUpload.service.ts. Adjust if your checkout layout differs.
VIDEO_PROCESSING_DIR=../video-processing
VIDEO_PROCESSING_PYTHON=../video-processing/venv/Scripts/python.exe
VIDEO_UPLOAD_DIR=./uploads
VIDEO_UPLOAD_MAX_MB=250

# --- Email notifications (Phase 2AO Stage 1) ---
# Real Gmail SMTP (smtp.gmail.com:587, STARTTLS) — see
# src/services/notification/emailProvider.ts. Requires a Gmail Account with 2-Step
# Verification enabled, then a 16-character App Password (NOT your real Gmail
# password): myaccount.google.com/apppasswords -> generate one for "Mail". Leave both
# unset to leave EMAIL unconfigured (LOG remains the only active channel — see
# notification/index.ts).
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=replace-with-a-16-char-app-password
NOTIFY_EMAIL_TO=security-team@example.com

# --- Email notifications via Resend (Phase 2AP Stage 1) ---
# HTTPS API (api.resend.com, port 443) alternative to the SMTP provider above — built
# because SMTP port 587 was blocked outright on a real network (see
# src/services/notification/resendEmailProvider.ts and the phase report). Standalone
# and unwired into the app for now — test with `npm run test:email:resend`. Get an API
# key at resend.com (Dashboard -> API Keys). RESEND_FROM_EMAIL defaults to Resend's own
# sandbox sender, which needs no domain setup but can only deliver to the email address
# the Resend account was signed up with, until a real sending domain is verified.
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
