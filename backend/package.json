{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI Surveillance platform — backend API, WebSocket server, database access, auth.",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate --schema=../database/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate --schema=../database/schema.prisma",
    "db:push": "prisma db push --schema=../database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../database/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=../database/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=../database/schema.prisma"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "@prisma/client": "^5.19.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
