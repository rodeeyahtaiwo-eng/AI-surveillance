# Copy to .env. No secrets here besides the shared ingest key used to authenticate to
# the backend — never commit the real .env.

HOST=0.0.0.0
PORT=8000

# Which adapter each pipeline stage uses. See docs/ai-pipeline.md for what each one
# actually is (real model vs. clearly-labeled demo/mock).
DETECTION_ADAPTER=yolov8          # yolov8 (real) | mock
ACTION_ADAPTER=demo_heuristic      # demo_heuristic only today
CAPTION_ADAPTER=template           # template (default) | blip (Phase 2R, real Salesforce/blip-image-captioning-base — see docs/phase2r-integration.md "Grounding rules" before enabling; not ground truth)
THREAT_ADAPTER=rule_based          # rule_based only today

# Optional refinement layer, orthogonal to ACTION_ADAPTER (see docs/ai-pipeline.md
# "Stage 2 - X3D-S refinement" before enabling — mode=REAL from this adapter means
# genuine model inference, NOT a validated/reliable violence detector; the Phase
# 2C-2G validation evidence is real but limited).
X3D_ADAPTER=none                   # none (default) | x3d_violence
X3D_HEAD_PATH=../models/violence_head.json
X3D_CONFIDENCE_THRESHOLD=0.5
X3D_EVAL_COOLDOWN_SECONDS=15
CLIP_BUFFER_MAX_FRAMES=16

# S3D Kinetics-400 (Phase 2R) — SUPPLEMENTARY signal only, never merged into the scored
# action label and never read by the threat engine. "none" (default) — disabled, zero
# cost. "s3d_kinetics400" — real torchvision inference, surfaced as
# ActionResult.s3d_prediction using the model's own unmapped 400-class vocabulary. See
# docs/phase2q-s3d-blip-temporal-feasibility.md: NOT validated as a violence detector.
S3D_ADAPTER=none
S3D_EVAL_COOLDOWN_SECONDS=20
S3D_NUM_FRAMES=16

# BLIP caption cadence (Phase 2R) — only relevant when CAPTION_ADAPTER=blip. Minimum
# seconds between real BLIP generations per camera; the cached/previous caption is
# reused in between. See docs/phase2q-s3d-blip-temporal-feasibility.md for the measured
# ~2-4s inference time and ~854MB generation-time RAM spike this cooldown protects against.
CAPTION_BLIP_COOLDOWN_SECONDS=20

# Temporal next-event predictor (Phase 2R) — SUPPLEMENTARY, never read by the threat
# engine. "none" (default) — disabled. "markov_v1" — order-1 empirical transition model
# over this camera's own in-memory action history (this process's uptime only — does
# NOT read historical backend data). Surfaced as ActionResult.temporal_prediction. See
# docs/phase2q-s3d-blip-temporal-feasibility.md for the prototype validation (71%
# walk-forward vs. 61% naive-repeat baseline on one historical sequence — not a
# generalization estimate).
TEMPORAL_PREDICTION_ADAPTER=none
TEMPORAL_PREDICTION_MAX_HISTORY=50

# YOLOv8 model file — auto-downloaded by ultralytics into ./models on first run if
# not already present. See ../models/README.md.
YOLO_MODEL_PATH=../models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45

# Knife evidence persistence (Phase 2S) — a "knife" detection (general YOLO, above)
# must be seen in at least KNIFE_PERSISTENCE_MIN_HITS of the sampled frames within the
# trailing KNIFE_PERSISTENCE_WINDOW_SECONDS, alongside a co-detected person, before it
# raises the threat score — see app/threat/rule_based.py's KNIFE_* constants. Defaults
# derived from SAMPLE_FPS=2 (video-processing default) and SEQUENCE_WINDOW_SECONDS
# below — the window here must stay <= SEQUENCE_WINDOW_SECONDS, or older confirming
# hits could already be pruned from the buffer before being counted.
KNIFE_PERSISTENCE_MIN_HITS=2
KNIFE_PERSISTENCE_WINDOW_SECONDS=4

# Rolling frame-window size (seconds) used for action recognition / threat analysis.
SEQUENCE_WINDOW_SECONDS=6

# Local diagnostic frame capture (Phase 2J, disabled by default) — saves the source
# frame + metadata (timestamp, camera, class, confidence, bbox, adapter, mode) for
# detections matching DIAGNOSTIC_CAPTURE_CLASSES, so false positives can be visually
# reviewed. Never sent to the backend, never exposed via any API — local disk only,
# under DIAGNOSTIC_CAPTURE_DIR (git-ignored). See docs/ai-pipeline.md "Diagnostic frame
# capture". Set DIAGNOSTIC_CAPTURE_ENABLED=false (or delete these lines) to disable.
DIAGNOSTIC_CAPTURE_ENABLED=false
DIAGNOSTIC_CAPTURE_CLASSES=knife     # comma-separated, e.g. knife,cat,dog,toothbrush
DIAGNOSTIC_CAPTURE_MAX_FRAMES=200    # per class subfolder, oldest evicted first
DIAGNOSTIC_CAPTURE_DIR=diagnostics/frames

# Backend ingestion endpoint (see backend/src/routes/inference.routes.ts) and the
# shared secret it expects in the `x-ingest-key` header — must match backend's
# INGEST_API_KEY exactly.
BACKEND_URL=http://localhost:4000
INGEST_API_KEY=replace-with-a-long-random-string
